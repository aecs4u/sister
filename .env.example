# Variabili d'ambiente per il servizio Visura API
# Copia questo file in .env e inserisci le tue credenziali:
#   cp .env.example .env

# === Credenziali SPID / Agenzia delle Entrate ===
ADE_USERNAME=il_tuo_codice_fiscale
ADE_PASSWORD=la_tua_password

# === Database PostgreSQL ===
DATABASE_DSN=postgresql+psycopg://utente:password@host:5432/sister?sslmode=require
# Schema holding the shared ISTAT foreign table municipalities (defaults to "istat").
DATABASE_ISTAT_SCHEMA=istat
# Optional PostGIS database for resolving cadastral parcel centroids and visura map geometries.
# CADASTRAL_POSTGRES_DSN=postgresql://utente:password@localhost:5432/cadastral
# Quotazioni OMI ufficiali (database "omi", schema public) per la stima OMI dei fabbricati nelle visure per soggetto.
# Se assente si usa STATS_POSTGRES_DSN (o CADASTRAL_POSTGRES_DSN) con il database sostituito da "omi".
# OMI_POSTGRES_DSN=postgresql://utente:password@localhost:5432/omi
# Giorni di validita' delle quotazioni OMI in cache (pagina /omi/valuation e stima nella pagina documento): OMI
# pubblica una volta a semestre. Default 30. La cache della panoramica e' su disco (outputs/cache/omi_overview).
# OMI_CACHE_DAYS=30
# SISTER_OMI_CACHE_DIR=

# Optional: separate PostgreSQL connection for Recrowd batch scripts. If unset, the historical-visura batch
# uses postgresql+psycopg://postgres@localhost/recrowd (and libpq password-file lookup).
# RECROWD_DATABASE_DSN=postgresql+psycopg://utente:password@host:5432/recrowd?sslmode=require

# === Autenticazione (opzionale, gestite da aecs4u-auth) ===
# ADE_AUTH_METHOD=spid              # spid | cie | cns | fisconline
# ADE_SPID_PROVIDER=sielte          # sielte | aruba | poste | namirial
# ADE_OTP_SECRET=                   # Secret TOTP base32 (per provider con OTP)
# BROWSER_MFA_TIMEOUT=120           # Timeout in secondi per approvazione MFA
# BROWSER_HEADLESS=true             # Esegui browser in modalità headless

# === Sessione SISTER (Chrome condiviso) ===
# Il servizio non fa login da solo: si aggancia alla sessione aperta in questo Chrome (avviato con
# --remote-debugging-port). Eseguire il login con `python scripts/ade_login.py` (vedi docs/portal_session.md).
# BROWSER_CDP_ENDPOINT=http://localhost:9222

# === Configurazione opzionale ===

# Root per documenti, dossier e output generati (default: cartella del progetto).
# SISTER_DATA_ROOT=/data/aecs4u.it/sister

# Cartella dei documenti scaricati da Richieste (la stessa letta dalla web UI). Se non impostata: <SISTER_OUTPUTS_DIR>/documents.
# SISTER_FILES_BASE=/data/aecs4u.it/sister/documents
# Cartella dei grafi proprietari/immobili (scripts/build_dossier_graph.py). Default: dossier_graphs/ accanto ai documenti.
# SISTER_DOSSIER_GRAPHS_DIR=/data/aecs4u.it/sister/dossier_graphs

# Directory di output (risposte, pagine, esportazioni).
# SISTER_OUTPUTS_DIR=/data/aecs4u.it/sister
# Directory dei collegamenti che mantengono i nomi originali forniti da SISTER.
# Default: <SISTER_OUTPUTS_DIR>/document_links
# SISTER_DOCUMENT_LINKS_DIR=/mnt/mobile/data/aecs4u.it/sister/document_links

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Protegge POST /shutdown via header X-API-Key
# SHUTDOWN_API_KEY=una_chiave_lunga

# Cache risultati
# RESPONSE_TTL_SECONDS=21600        # Default 6 ore
# RESPONSE_MAX_ITEMS=5000           # Massimo risultati in memoria

# === CLI client configuration ===
# Used by `visura-api` CLI and VisuraClient
# VISURA_API_URL=http://localhost:8000    # Base URL of the service
# VISURA_API_KEY=                         # Same as API_KEY above
# VISURA_API_TIMEOUT=30                   # HTTP timeout in seconds
# VISURA_POLL_INTERVAL=5                  # Seconds between status polls
# VISURA_POLL_TIMEOUT=300                 # Max seconds to wait for a result

# === Conservazione dei risultati ===
# RESPONSE_TTL_SECONDS=21600                # solo cache in memoria / validità della cache (6 h)
# DB_RETENTION_SECONDS=0                    # 0 = i risultati restano nel database per sempre (predefinito);
#                                           # > 0 = cancella dal database le risposte più vecchie di N secondi

# === Web UI: accesso e protezioni ===
# REQUIRE_AUTHENTICATION=true               # false = solo sviluppo: le rotte /web/* accettano richieste anonime
# LOCAL_USERS_FILE=../local_users.sister.txt   # "utente  password" per riga; password hashate con scripts/hash_local_password.py
# ALLOW_PLAINTEXT_USERS=false              # solo sviluppo: true consente password in chiaro; di default il servizio rifiuta l'avvio
#                                           # (genera l'hash con: python scripts/hash_local_password.py <utente>)
# SISTER_ADMIN_USERS=                       # utenti (separati da virgola) che possono usare Browser Control, import e
#                                           # rescan; vuoto = ogni utente autenticato (nessun admin predefinito)
# SISTER_COOKIE_SECURE=auto                # auto = cookie "Secure" solo su richieste HTTPS; always = sempre (proxy TLS senza X-Forwarded-Proto)
# SISTER_RATE_LIMIT_PER_MIN=600             # richieste/minuto per client (default)
# SISTER_AUTH_RATE_LIMIT_PER_MIN=20         # richieste/minuto per client su /auth/* (anti brute-force)

# GOOGLE_MAPS_API_KEY=                     # vista 3D edificio (/web/3d): chiave Google Maps Platform con Maps JavaScript API, limitata per referrer

# Non modificare queste (necessarie per Playwright in Docker)
PYTHONUNBUFFERED=1
DISPLAY=:99

# Geocodifica esterna (Nominatim/OpenStreetMap) per posizionare gli immobili senza geometria catastale.
# "off" non invia mai indirizzi a terzi (la cache su disco, data/geocode_cache.json, resta usata).
# SISTER_GEOCODING=on
# SISTER_GEOCODE_CACHE=data/geocode_cache.json

# Avvio senza interfaccia web quando un import della UI fallisce (default: l'avvio fallisce, cosi' l'errore si vede).
# SISTER_ALLOW_NO_WEB_UI=false

# Pagamento dei documenti con Stripe Checkout tramite aecs4u-billing (inattivo finche' non sono impostate tutte e tre).
# Il prezzo viene sempre dal server: SISTER_DOCUMENT_PRICE_ID e' il Price Stripe del documento; elencalo anche in
# ALLOWED_STRIPE_PRICE_IDS. Il webhook firmato e' POST /webhooks/stripe (crea l'accesso con source=stripe).
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SISTER_DOCUMENT_PRICE_ID=price_...
# ALLOWED_STRIPE_PRICE_IDS=price_...
# SISTER_DOCUMENT_PRICE_CENTS=1290
# AECS4U_SITE_ID=sister

# Crediti prepagati (aecs4u-billing wallet): costo di un documento in crediti. I saldi stanno nel PostgreSQL di SISTER
# (tabelle billing_wallets / billing_transactions, migrazione 20261119): nessun Redis necessario. SISTER_WALLET_STORAGE sceglie
# un altro backend: redis (usa REDIS_URL) o memory (solo sviluppo, si azzera al riavvio).
# Gli admin accreditano crediti da /admin/document-purchases; l'acquirente paga dalla pagina /buy/<link firmato>.
# SISTER_DOCUMENT_CREDITS=10
# Query portal pricing is read from OpenData GET /api/pricing. Each SISTER command matches its /visura/... endpoint;
# customer_credits is used when supplied, otherwise the API's EUR amount is converted at 100 credits per euro.
# CSV rows use the selected command price (or the shared fallback); each planned workflow step uses the shared fallback.
# OpenData must publish an active shared fallback row for POST /visura/query. Missing prices fail closed.
# OPENDATA_API_URL=http://localhost:8024
# SISTER_QUERY_SHARED_PRICE_PATH=/visura/query
# SISTER_WALLET_STORAGE=sql
# REDIS_URL=redis://localhost:6379/0
# I link di acquisto /buy/<token> sono firmati con SECRET_KEY (o SISTER_LINK_SECRET) e scadono dopo SISTER_PURCHASE_LINK_DAYS giorni.
# SISTER_LINK_SECRET=
# SISTER_PURCHASE_LINK_DAYS=30

# Pagine soggetto/documento: attesa massima della mappa dei fondi, memo per documento e rilettura in background (secondi).
# SISTER_HUB_MAP_WAIT_SECONDS=2
# SISTER_MAP_CONTEXT_SECONDS=600
# SISTER_MAP_REFRESH_SECONDS=600
